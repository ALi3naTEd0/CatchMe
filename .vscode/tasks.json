{
  "version": "2.0.0",
  "tasks": [
    { "label": "Go: tests (race)", "type": "shell", "command": "make test", "options": { "cwd": "${workspaceFolder}/catchmed" }, "group": { "kind": "test", "isDefault": true }, "problemMatcher": "$go" },
    { "label": "Go: fuzz Plan (30 s)", "type": "shell", "command": "make fuzz", "options": { "cwd": "${workspaceFolder}/catchmed" }, "group": "test", "problemMatcher": "$go" },
    { "label": "Go: benchmarks", "type": "shell", "command": "make bench", "options": { "cwd": "${workspaceFolder}/catchmed" }, "group": "test", "problemMatcher": "$go" },
    { "label": "Go: cobertura (abre HTML)", "type": "shell", "command": "make cover", "options": { "cwd": "${workspaceFolder}/catchmed" }, "group": "test", "problemMatcher": "$go" },
    { "label": "Go: build catchmed", "type": "shell", "command": "make build", "options": { "cwd": "${workspaceFolder}/catchmed" }, "group": { "kind": "build", "isDefault": true }, "problemMatcher": "$go" }
  ]
}
